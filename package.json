{
  "name": "datashield",
  "version": "1.0.0",
  "description": "DataShield is a self-hosted service that lets businesses know if these employees haven't had compromised data",
  "homepage": "https://github.com/WhiteMuush/DataShield#readme",
  "bugs": {
    "url": "https://github.com/WhiteMuush/DataShield/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteMuush/DataShield.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Melvin PETIT (WhiteMuush)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "prisma migrate status || echo '\\n[!] Pending migrations or DB unreachable. If the app errors on a missing table, run: npm run db:migrate\\n'",
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:up": "sh scripts/db-up.sh",
    "db:down": "sh scripts/db-down.sh",
    "db:init": "sh scripts/db-init.sh",
    "db:migrate": "prisma migrate deploy",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore": "sh scripts/db-restore.sh",
    "postinstall": "prisma generate",
    "prepare": "sh .githooks/install.sh",
    "seed:dev": "dotenv -e .env.local -- tsx prisma/seed.dev.ts",
    "seed:2fa": "dotenv -e .env.local -- tsx prisma/seed.2fa.ts",
    "reencrypt:directory": "dotenv -e .env.local -- tsx scripts/reencrypt-directory-configs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-identitystore": "^3.1106.0",
    "@base-ui/react": "^1.7.0",
    "@better-auth/passkey": "^1.6.25",
    "@better-auth/sso": "1.6.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ldapts": "^9.0.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-grid-layout": "^2.1.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.26",
    "sharp": "^0.35.3",
    "valibot": "^1.4.2",
    "find-my-way": "^9.7.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18"
  }
}
