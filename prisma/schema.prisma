generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  employees            Employee[]
  alerts               Alert[]
  dashboardPresets     DashboardPreset[]
  directoryConnections DirectoryConnection[]
  apiCredentials       ApiCredential[]
}

model DirectoryConnection {
  id              String        @id @default(cuid())
  companyId       String
  type            DirectoryType
  name            String
  encryptedConfig String
  status          ConnectStatus @default(PENDING)
  lastSyncAt      DateTime?
  lastSyncCount   Int?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum DirectoryType {
  AZURE_AD
  GOOGLE_WORKSPACE
  LDAP
  AWS_DIRECTORY
  OKTA
  SCIM
}

enum ConnectStatus {
  ACTIVE
  ERROR
  PENDING
}

model ApiCredential {
  id           String        @id @default(cuid())
  companyId    String
  provider     ApiProvider
  label        String
  encryptedKey String
  keyHint      String
  status       ConnectStatus @default(PENDING)
  lastUsedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
}

enum ApiProvider {
  HIBP
  DEHASHED
  LEAKCHECK
  INTELX
  SNUSBASE
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  role           Role     @default(VIEWER)
  companyId      String
  createdAt      DateTime @default(now())

  activePresetId  String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dashboardConfig  DashboardConfig?
  dashboardPresets DashboardPreset[] @relation("UserPresets")
  activePreset     DashboardPreset?  @relation("ActivePreset", fields: [activePresetId], references: [id], onDelete: SetNull)
}

model DashboardConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  layout    Json     @default("[]")
  widgets   Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardPreset {
  id        String      @id @default(cuid())
  userId    String?
  companyId String
  name      String
  scope     PresetScope @default(PERSONAL)
  layout    Json        @default("[]")
  widgets   Json        @default("[]")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user        User?    @relation("UserPresets", fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activeUsers User[]   @relation("ActivePreset")

  @@index([userId])
  @@index([companyId])
}

enum Role {
  ADMIN
  VIEWER
}

enum PresetScope {
  PERSONAL
  COMPANY
}

model Employee {
  id         String   @id @default(cuid())
  email      String
  firstName  String
  lastName   String
  department String?
  companyId  String
  createdAt  DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  breachRecords BreachRecord[]
  alerts        Alert[]

  @@unique([email, companyId])
}

model Breach {
  id          String       @id @default(cuid())
  name        String       @unique
  source      BreachSource @default(HIBP)
  breachDate  DateTime
  description String?
  dataTypes   String[]
  createdAt   DateTime     @default(now())

  records BreachRecord[]
  alerts  Alert[]
}

enum BreachSource {
  HIBP
  MANUAL
  DARK_WEB
}

model BreachRecord {
  id          String   @id @default(cuid())
  employeeId  String
  breachId    String
  exposedData String[]
  detectedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  breach   Breach   @relation(fields: [breachId], references: [id], onDelete: Cascade)

  @@unique([employeeId, breachId])
}

model Alert {
  id         String      @id @default(cuid())
  companyId  String
  employeeId String?
  breachId   String?
  severity   Severity
  status     AlertStatus @default(OPEN)
  message    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  breach   Breach?   @relation(fields: [breachId], references: [id], onDelete: SetNull)
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}
