generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  logoUrl   String?
  // Auto-scan cadence in minutes (null = disabled); lastScanAt tracks the last
  // scheduler-triggered scan so the next one is only due after the interval.
  scanIntervalMinutes Int?
  lastScanAt          DateTime?
  // Per-company override of the per-employee risk weights (see lib/risk.ts).
  // Null falls back to DEFAULT_RISK_WEIGHTS.
  riskWeights Json?
  // Master switch for live remediation (force reset / revoke sessions) against
  // the connected directory. Off by default: actions on the customer's IdP must
  // be deliberately enabled in settings before they can run.
  remediationEnabled Boolean @default(false)
  // Encrypted bearer token for the SIEM pull feed, plus a non-secret hint shown
  // in settings. Null when no SIEM export is configured.
  siemTokenEnc  String?
  siemTokenHint String?
  // Optional SIEM push: alerts are POSTed in batches to this HTTPS endpoint by
  // the scheduler. siemPushSince tracks the last delivered alert.
  siemPushUrlEnc  String?
  siemPushHint    String?
  siemPushFormat  String?
  siemPushSince   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  employees            Employee[]
  alerts               Alert[]
  dashboardPresets     DashboardPreset[]
  directoryConnections DirectoryConnection[]
  apiCredentials       ApiCredential[]
  webhooks             Webhook[]
  remediationActions   RemediationAction[]
  exposureRegister     ExposureRegisterEntry[]
  reportSchedules      ReportSchedule[]
}

// A recurring report emailed to a recipient list (driven by the scheduler).
model ReportSchedule {
  id         String            @id @default(cuid())
  companyId  String
  frequency  ScheduleFrequency
  recipients String[]
  sections   String[]
  enabled    Boolean           @default(true)
  lastSentAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum ScheduleFrequency {
  WEEKLY
  MONTHLY
}

// GDPR Article 33/30 exposure register: a documented record of each confirmed
// personal-data exposure, whether or not it required notification.
model ExposureRegisterEntry {
  id             String         @id @default(cuid())
  companyId      String
  title          String
  detectedAt     DateTime
  status         RegisterStatus @default(ASSESSING)
  affectedCount  Int            @default(0)
  dataCategories String[]
  assessment     String?
  notifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum RegisterStatus {
  ASSESSING
  NOTIFIED
  NOT_REQUIRED
}

// Append-only audit of remediation actions taken against the directory.
model RemediationAction {
  id          String            @id @default(cuid())
  companyId   String
  employeeId  String?
  alertId     String?
  action      RemediationType
  status      RemediationStatus
  target      String
  detail      String?
  performedBy String?
  createdAt   DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum RemediationType {
  REVOKE_SESSIONS
  FORCE_PASSWORD_RESET
}

enum RemediationStatus {
  SUCCESS
  FAILED
}

model DirectoryConnection {
  id              String        @id @default(cuid())
  companyId       String
  type            DirectoryType
  name            String
  encryptedConfig String
  status          ConnectStatus @default(PENDING)
  lastSyncAt      DateTime?
  lastSyncCount   Int?
  errorMessage    String?
  // Auto-sync cadence in minutes (null = disabled). The scheduler enqueues a
  // SyncJob once lastSyncAt is older than this interval.
  autoSyncIntervalMinutes Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  syncJobs SyncJob[]

  @@index([companyId])
}

model SyncJob {
  id           String        @id @default(cuid())
  connectionId String
  status       SyncJobStatus @default(PENDING)
  attempts     Int           @default(0)
  maxAttempts  Int           @default(3)
  lastError    String?
  runAfter     DateTime      @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  connection DirectoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([connectionId])
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum DirectoryType {
  AZURE_AD
  GOOGLE_WORKSPACE
  LDAP
  AWS_DIRECTORY
  OKTA
  SCIM
}

enum ConnectStatus {
  ACTIVE
  ERROR
  PENDING
}

model ApiCredential {
  id           String        @id @default(cuid())
  companyId    String
  provider     ApiProvider
  label        String
  encryptedKey String
  keyHint      String
  status       ConnectStatus @default(PENDING)
  lastUsedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
}

enum ApiProvider {
  HIBP
  HIBP_STEALER
  DEHASHED
  LEAKCHECK
  INTELX
  SNUSBASE
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  role           Role     @default(VIEWER)
  companyId      String
  createdAt      DateTime @default(now())

  activePresetId  String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dashboardConfig  DashboardConfig?
  dashboardPresets DashboardPreset[] @relation("UserPresets")
  activePreset     DashboardPreset?  @relation("ActivePreset", fields: [activePresetId], references: [id], onDelete: SetNull)
}

model DashboardConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  layout    Json     @default("[]")
  widgets   Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DashboardPreset {
  id        String      @id @default(cuid())
  userId    String?
  companyId String
  name      String
  scope     PresetScope @default(PERSONAL)
  layout    Json        @default("[]")
  widgets   Json        @default("[]")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user        User?    @relation("UserPresets", fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activeUsers User[]   @relation("ActivePreset")

  @@index([userId])
  @@index([companyId])
}

enum Role {
  ADMIN
  VIEWER
}

enum PresetScope {
  PERSONAL
  COMPANY
}

model Employee {
  id         String   @id @default(cuid())
  email      String
  firstName  String
  lastName   String
  department String?
  companyId  String
  // MFA enrollment from the directory sync: true/false when the provider
  // reports it, null when unknown (provider has no capability or not synced).
  mfaEnabled Boolean?
  createdAt  DateTime @default(now())

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  breachRecords BreachRecord[]
  alerts        Alert[]

  @@unique([email, companyId])
}

model Breach {
  id          String       @id @default(cuid())
  name        String       @unique
  source      BreachSource @default(HIBP)
  breachDate  DateTime
  description String?
  dataTypes   String[]
  createdAt   DateTime     @default(now())

  records BreachRecord[]
  alerts  Alert[]
}

enum BreachSource {
  HIBP
  MANUAL
  DARK_WEB
  STEALER_LOG
}

// Stolen artifact captured in a stealer log. Session cookies and tokens bypass
// MFA, so they outrank a plaintext password, which outranks an autofill entry.
enum ArtifactKind {
  PASSWORD
  COOKIE
  TOKEN
  AUTOFILL
}

model BreachRecord {
  id          String         @id @default(cuid())
  employeeId  String
  breachId    String
  exposedData String[]
  artifacts   ArtifactKind[]
  // Infection metadata, present only for stealer-log findings whose feed
  // exposes it (machine identifier, malware family, capture time).
  machineId     String?
  malwareFamily String?
  capturedAt    DateTime?
  detectedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  breach   Breach   @relation(fields: [breachId], references: [id], onDelete: Cascade)

  @@unique([employeeId, breachId])
}

model Alert {
  id         String      @id @default(cuid())
  companyId  String
  employeeId String?
  breachId   String?
  severity   Severity
  // How reliable the reporting source is, derived from the provider tier (see
  // lib/credentials/providers.ts). Orthogonal to severity: a real exposure stays
  // severe whoever reported it, but a low-confidence hit (noisy OSINT feed) is
  // flagged so a responder verifies before acting.
  confidence AlertConfidence @default(MEDIUM)
  status     AlertStatus @default(OPEN)
  message    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  breach   Breach?   @relation(fields: [breachId], references: [id], onDelete: SetNull)
}

model Webhook {
  id           String              @id @default(cuid())
  companyId    String
  label        String
  channel      NotificationChannel @default(WEBHOOK)
  // Encrypted delivery target: an HTTPS URL for WEBHOOK/SLACK/TEAMS, a recipient
  // address for EMAIL.
  encryptedUrl String
  urlHint      String
  minSeverity  Severity            @default(MEDIUM)
  enabled      Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

enum NotificationChannel {
  WEBHOOK
  SLACK
  TEAMS
  EMAIL
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertConfidence {
  HIGH
  MEDIUM
  LOW
}
