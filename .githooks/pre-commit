#!/usr/bin/env sh
# Local gate: nothing non-compliant gets committed. Mirrors the CI compliance job.
set -eu

root="$(git rev-parse --show-toplevel)"
lib="$root/.githooks/lib"
status=0

added="$(mktemp)"
trap 'rm -f "$added"' EXIT
sh "$lib/added-lines.sh" staged > "$added"

# Changed file paths (newline-split so spaces survive).
files="$(git diff --cached --name-only --diff-filter=ACMR)"
old_ifs="$IFS"; IFS='
'
# shellcheck disable=SC2086
set -- $files
IFS="$old_ifs"

echo "[pre-commit] lint"
npm run lint -- --max-warnings 0 || status=1

echo "[pre-commit] compliance checks"
sh "$lib/run-all.sh" "HEAD:package.json" ":package.json" "$added" -- "$@" || status=1

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Commit blocked by DataShield policy. Fix the issues above."
  echo "These checks also run in CI. Do not bypass with --no-verify."
fi

exit $status
